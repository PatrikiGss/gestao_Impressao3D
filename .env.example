# Copie este arquivo para .env e ajuste os valores.
#   cp .env.example .env        (Linux/macOS)
#   copy .env.example .env      (Windows)

# ---------------------------------------------------------------------------
# Básico
# ---------------------------------------------------------------------------

# True em desenvolvimento, False em produção.
DEBUG=True

# Obrigatória quando DEBUG=False. Gere a sua com:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# Domínios que podem servir a aplicação, separados por vírgula.
# Com DEBUG=False, qualquer host fora desta lista recebe HTTP 400.
ALLOWED_HOSTS=localhost,127.0.0.1

# ---------------------------------------------------------------------------
# Banco de dados
# ---------------------------------------------------------------------------

# Em produção o Render fornece a URL completa do Postgres nesta variável, e
# ela tem precedência sobre as DB_* abaixo.
# DATABASE_URL=postgres://usuario:senha@host:5432/banco

# sqlite3 (padrão, não exige nada instalado) ou postgresql.
DB_ENGINE=sqlite3

# As variáveis abaixo só são lidas quando DB_ENGINE não é sqlite3.
# DB_ENGINE=postgresql
# DB_NAME=impressao3d
# DB_USER=postgres
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=5432

# ---------------------------------------------------------------------------
# Arquivos enviados
# ---------------------------------------------------------------------------

# Onde ficam os modelos 3D enviados. Só precisa ser definida se você apontar
# para um disco persistente — ver "Arquivos enviados" no README.
# MEDIA_ROOT=/var/data/media
